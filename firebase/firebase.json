      { "source": "/home-legacy/specials{,/}", "destination": "/", "type": 301 },
      { "source": "/home-legacy/live-music{,/}", "destination": "/", "type": 301 },
      { "source": "/home-legacy/online-ordering{,/}", "destination": "/", "type": 301 },
      { "source": "/home-legacy/menu-kids{,/}", "destination": "/", "type": 301 },
      { "source": "/home-legacy/catering-and-private-parties{,/}", "destination": "/catering/", "type": 301 },
      { "source": "/home-legacy/gallery-legacy{,/}", "destination": "/gallery/", "type": 301 },
      { "source": "/home-legacy/photo-gallery{,/}", "destination": "/gallery/", "type": 301 },
      { "source": "/home-legacy/contact-us-legacy{,/}", "destination": "/contact-us/", "type": 301 },
      { "source": "/home-legacy/career-opportunities{,/}", "destination": "/careers/", "type": 301 },
      { "source": "/home-legacy/gift-cards-legacyy{,/}", "destination": "/gift-cards/", "type": 301 },
      { "source": "/home-legacy/gift-card-legacy{,/}", "destination": "/gift-cards/", "type": 301 },
      { "source": "/home-legacy/shop{,/}", "destination": "/gift-cards/", "type": 301 },
      { "source": "/home-legacy/cart{,/}", "destination": "/gift-cards/", "type": 301 },
      { "source": "/home-legacy/checkout{,/}", "destination": "/gift-cards/", "type": 301 },
      { "source": "/home-legacy/middletown-legacy{,/}", "destination": "/middletown/", "type": 301 },
      { "source": "/home-legacy/menu{,/}", "destination": "/middletown/", "type": 301 },
      { "source": "/home-legacy/menu-middletown-*{,/}", "destination": "/middletown/", "type": 301 },
      { "source": "/home-legacy/highlands-legacy{,/}", "destination": "/highlands/", "type": 301 },
      { "source": "/home-legacy/menu-highlands-*{,/}", "destination": "/highlands/", "type": 301 },
      { "source": "/home-legacy/st-matthews-legacy{,/}", "destination": "/st-matthews/", "type": 301 },
      { "source": "/home-legacy/menu-st-matthews-*{,/}", "destination": "/st-matthews/", "type": 301 },
      { "source": "/home-legacy/lyndon-legacy{,/}", "destination": "/lyndon/", "type": 301 },
      { "source": "/home-legacy/mojito-tapas{,/}", "destination": "/lyndon/", "type": 301 },
      { "source": "/home-legacy/menu-lyndon-*{,/}", "destination": "/lyndon/", "type": 301 },
      { "source": "/home-legacy/**", "destination": "/", "type": 301 },

      { "source": "/our-story{,/}", "destination": "/about/", "type": 301 },
      { "source": "/cuban-cuisine{,/}", "destination": "/about/", "type": 301 },
      { "source": "/locations-and-hours{,/}", "destination": "/about/", "type": 301 },
      { "source": "/reviews{,/}", "destination": "/", "type": 301 },
      { "source": "/happenings-specials{,/}", "destination": "/", "type": 301 },
      { "source": "/specials{,/}", "destination": "/", "type": 301 },
      { "source": "/live-music{,/}", "destination": "/", "type": 301 },
      { "source": "/online-ordering{,/}", "destination": "/", "type": 301 },
      { "source": "/menu-kids{,/}", "destination": "/", "type": 301 },
      { "source": "/catering-and-private-parties{,/}", "destination": "/catering/", "type": 301 },
      { "source": "/photo-gallery{,/}", "destination": "/gallery/", "type": 301 },
      { "source": "/contact{,/}", "destination": "/contact-us/", "type": 301 },
      { "source": "/career-opportunities{,/}", "destination": "/careers/", "type": 301 },
      { "source": "/gift-card{,/}", "destination": "/gift-cards/", "type": 301 },
      { "source": "/shop{,/}", "destination": "/gift-cards/", "type": 301 },
      { "source": "/cart{,/}", "destination": "/gift-cards/", "type": 301 },
      { "source": "/checkout{,/}", "destination": "/gift-cards/", "type": 301 },
      { "source": "/menu{,/}", "destination": "/middletown/", "type": 301 },
      { "source": "/menu-middletown-*{,/}", "destination": "/middletown/", "type": 301 },
      { "source": "/menu-highlands-*{,/}", "destination": "/highlands/", "type": 301 },
      { "source": "/menu-st-matthews-*{,/}", "destination": "/st-matthews/", "type": 301 },
      { "source": "/mojito-tapas{,/}", "destination": "/lyndon/", "type": 301 },
      { "source": "/menu-lyndon-*{,/}", "destination": "/lyndon/", "type": 301 },

      { "source": "/author/**", "destination": "/", "type": 301 },
      { "source": "/feed{,/**}", "destination": "/", "type": 301 },
      { "source": "/comments/feed{,/**}", "destination": "/", "type": 301 },
      { "source": "/wp-sitemap{,-*}.xml", "destination": "/sitemap.xml", "type": 301 },
      { "source": "/wp-content/uploads/2026/03/Havana-Rumba-Catering-.pdf", "destination": "/catering/", "type": 301 }
    ],
    "headers": [
      { "source": "_nuxt/**",  "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "_fonts/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "images/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "videos/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  },
  "functions": [
    { "source": "functions", "codebase": "default" }
  ]
}
