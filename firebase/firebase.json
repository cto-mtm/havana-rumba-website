{
  "hosting": {
    "public": "www",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      { "source": "/home-legacy{,/}", "destination": "/", "type": 301 },
      { "source": "/home-legacy/our-story{,/}", "destination": "/about/", "type": 301 },
      { "source": "/home-legacy/cuban-cuisine{,/}", "destination": "/about/", "type": 301 },
      { "source": "/home-legacy/locations-and-hours{,/}", "destination": "/about/", "type": 301 },
